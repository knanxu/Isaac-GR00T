PYTHON_BIN=.venv/bin/python
ROS_SETUP=/opt/ros/noetic/setup.bash

ROLLOUT_MODE=plain
INFERENCE_MODE=sync
CONTROL_INTERFACE=gui
ROS_NAMESPACE=/gr00t_rollout

POLICY_SERVER_HOST=127.0.0.1
POLICY_SERVER_PORT=47866
TASK="move parcel onto conveyor belt one by one"
POLICY_FREQUENCY=30
CONTROL_FREQUENCY=250
TTS_SAMPLES=1
SERVO_GAIN=800
EPISODE_DURATION_S=80
DRY_RUN=1
DISABLE_PINCH=0

# Plain TOPPRA constraints. Confirm these limits against the robot before DRY_RUN=0.
MAX_LINEAR_VELOCITY=1.0
MAX_ANGULAR_VELOCITY=3.0
MAX_LINEAR_ACCELERATION=5.0
MAX_ANGULAR_ACCELERATION=15.0
SAFETY_MARGIN=0.9
PLAIN_LOG_ROOT=logs/kion_rollout

# Speed-RL options. These measured-twist thresholds have no default by design.
SPEED_RL_PHASE=calibration
LEFT_TWIST_THRESHOLDS=
RIGHT_TWIST_THRESHOLDS=
SPEED_RL_STATE_ROOT=logs/kion_speed_rl/state
SPEED_RL_LOG_ROOT=logs/kion_speed_rl/episodes
SPEED_RL_CHECKPOINT=
ASYNC_VERIFICATION=
